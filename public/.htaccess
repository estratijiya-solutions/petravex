# Security headers — the same set Traefik supplied on the VPS.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content-Security-Policy — deliberately narrow.
    #   upgrade-insecure-requests : keeps what the hcdn edge already sends.
    #   frame-ancestors 'self'    : the modern X-Frame-Options; same restriction,
    #                               but one browsers still honour.
    #   object-src 'none'         : kills <object>/<embed> injection.
    #   base-uri 'self'           : stops an injected <base> rewriting every
    #                               relative URL on the page.
    # No default-src/script-src/form-action on purpose — those need a full
    # inventory of every inline script and form endpoint per site, and getting
    # one wrong breaks the page silently. These four are safe on a static site.
    Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
</IfModule>

# English lives at the site root (that is how every internal link and every
# indexed URL is written). The static export emits it under /en/, and the
# files have been moved up — so anything still asking for /en/... gets a
# permanent redirect to the canonical bare path.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^en/?$ / [R=301,L]
    RewriteRule ^en/(.*)$ /$1 [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>


