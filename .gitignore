# dependencies
node_modules/

# build output
.next/
out/
build/
dist/

# env — everything, no exceptions except the committed example
.env
.env.*
.env*.local
!.env.example

# deployment platforms
.vercel
.netlify

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# typescript build info
next-env.d.ts
*.tsbuildinfo

# secrets / deployment artifacts — NEVER commit any of these.
# 2026-09-01 audit: deploy.local.env held a plaintext VPS password on disk.
# It was moved out of the repo; the pattern below is deliberately broad.
.deploy/
*.local.env
deploy.local.env
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
known_hosts
credentials*
secrets*

# local databases / scratch runtime state
*.db
*.db-shm
*.db-wal
.dev-*.log

# claude
.claude/

# cross-client scratch — these are NOT Petravex artifacts and must never be
# committed here. Server audits in particular carry infrastructure detail for
# every client. Moved to F:/coding/_scratch/ on 2026-07-14.
AUDIT-*.md
*-AUDIT.md
.agents/
skills-lock.json

# ...except this site's OWN audit reports, which belong in the repo.
!docs/AUDIT-*.md
